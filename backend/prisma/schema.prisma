generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  operativeName  String?  
  email          String    @unique
  password       String
  xp             Int       @default(0)
  level          Int       @default(1)
  clearanceLevel String    @default("Level_01")
  streakCount    Int       @default(0)
  lastActivity   DateTime? 
  lastLogin      DateTime?
  achievements   UserAchievement[] 
  progress       UserProgress[]
  problemProgress ProblemProgress[]
  leaderboard    Leaderboard?
  codeSubmissions CodeSubmission[]
  attempts       Attempt[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}


model Achievement {
  id          String   @id @default(uuid())
  name        String  
  code        String   @unique
  description String
  type        String  
  xpReward    Int      @default(50)
  
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId]) 
  @@map("user_achievements")
}

model Course {
  id           String   @id @default(uuid())
  title        String   
  description  String?
  topics       Topic[]
  modules      Module[]

  userProgress UserProgress[] 
  
  createdAt    DateTime @default(now())
}

model Module {
  id            String   @id @default(uuid())
  title         String
  subTitle      String   // e.g., "Module_04"
  description   String?  @db.Text
  difficulty    String   @default("intermediate")
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "modules_course_fkey_custom")
  
  problems      CodeProblem[]
  progress      ProblemProgress[]
  
  createdAt     DateTime @default(now())
  
  @@map("modules")
}

model Topic {
  id          String   @id @default(uuid())
  name        String  
  description String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
}

model Quiz {
  id          String   @id @default(uuid())
  title       String
  description String?
  difficulty  String  
 
  isDaily     Boolean  @default(false) 
  dailyDate   DateTime? 
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id])
  
  questions   Question[]
  attempts    Attempt[]
  
  createdAt   DateTime @default(now())
}

model Question {
  id              String   @id @default(uuid())
  text            String
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options         Option[]
  correctOptionId String?   
  explanation     String?
}

model Option {
  id         String   @id @default(uuid())
  text       String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id])
  
  score        Int      @default(0)
  isCompleted  Boolean  @default(false)
  timeTakenSec Int?     
  finishedAt   DateTime?
}

model UserProgress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  
  percentage Int      @default(0) 
  lastAccess DateTime @default(now())

  @@unique([userId, courseId])
}

model ProblemProgress {
  id           String      @id @default(uuid())
  userId       String
  problemId    String
  moduleId     String?
  completed    Boolean     @default(false)
  completedAt  DateTime?
  attempts     Int         @default(0)
  
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      CodeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  module       Module?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@unique([userId, problemId])
  @@map("problem_progress")
}

model Leaderboard {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  totalXP     Int      @default(0)
  rank        Int?
  lastUpdated DateTime @default(now())
}

model CodeProblem {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  difficulty  String
  language    String
  starterCode String   @db.Text
  xpReward    Int      @default(100)
  
  problemType String?  @default("standard")
  constraints String?  @db.Text
  
  moduleId    String?
  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  
  testCases   TestCase[]
  submissions CodeSubmission[]
  progress    ProblemProgress[]
  
  createdAt   DateTime @default(now())
  
  @@map("code_problems")
}

model TestCase {
  id             String      @id @default(uuid())
  problemId      String
  problem        CodeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  
  input          String      @db.Text
  expected       String?     @db.Text
  expectedOutput String?     @db.Text
  isHidden       Boolean     @default(false)
  description    String?
  
  @@map("test_cases")
}

model CodeSubmission {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  problemId  String
  problem    CodeProblem @relation(fields: [problemId], references: [id])
  
  code       String      @db.Text
  language   String
  status     String
  output     String?     @db.Text
  error      String?     @db.Text
  
  testsPassed Int       @default(0)
  testsTotal  Int       @default(0)
  
  executionTime Int?
  
  createdAt  DateTime  @default(now())
  
  @@map("code_submissions")
}